        case 'EDM_EP3QuestAvailableFromNonActor': e_type = EDM_EP3QuestAvailableFromNonActor; break;
        case 'EDM_Blacksmith': e_type = EDM_Blacksmith; break;
    }
    EnableDynamicMappin(tag, enable, e_type, showAlways);
}

