        case 'EBG_Combat_1Handed_Blunt': e_preferedCombatStyle = EBG_Combat_1Handed_Blunt; break;
        case 'EBG_Combat_1Handed_Any': e_preferedCombatStyle = EBG_Combat_1Handed_Any; break;
        case 'EBG_Combat_2Handed_Any': e_preferedCombatStyle = EBG_Combat_2Handed_Any; break;
        case 'EBG_Combat_2Handed_Sword': e_preferedCombatStyle = EBG_Combat_2Handed_Sword; break;
        case 'EBG_Combat_2Handed_Hammer': e_preferedCombatStyle = EBG_Combat_2Handed_Hammer; break;
        case 'EBG_Combat_2Handed_Axe': e_preferedCombatStyle = EBG_Combat_2Handed_Axe; break;
        case 'EBG_Combat_2Handed_Halberd': e_preferedCombatStyle = EBG_Combat_2Handed_Halberd; break;
        case 'EBG_Combat_2Handed_Spear': e_preferedCombatStyle = EBG_Combat_2Handed_Spear; break;
        case 'EBG_Combat_2Handed_Staff': e_preferedCombatStyle = EBG_Combat_2Handed_Staff; break;
        case 'EBG_Combat_Fists': e_preferedCombatStyle = EBG_Combat_Fists; break;
        case 'EBG_Combat_Bow': e_preferedCombatStyle = EBG_Combat_Bow; break;
        case 'EBG_Combat_Crossbow': e_preferedCombatStyle = EBG_Combat_Crossbow; break;
        case 'EBG_Combat_Witcher': e_preferedCombatStyle = EBG_Combat_Witcher; break;
        case 'EBG_Combat_Sorceress': e_preferedCombatStyle = EBG_Combat_Sorceress; break;
        case 'EBG_Combat_WildHunt_Imlerith': e_preferedCombatStyle = EBG_Combat_WildHunt_Imlerith; break;
        case 'EBG_Combat_WildHunt_Imlerith_Second_Stage': e_preferedCombatStyle = EBG_Combat_WildHunt_Imlerith_Second_Stage; break;
        case 'EBG_Combat_WildHunt_Caranthir': e_preferedCombatStyle = EBG_Combat_WildHunt_Caranthir; break;
        case 'EBG_Combat_WildHunt_Caranthir_Second_Stage': e_preferedCombatStyle = EBG_Combat_WildHunt_Caranthir_Second_Stage; break;
        case 'EBG_Combat_WildHunt_Eredin': e_preferedCombatStyle = EBG_Combat_WildHunt_Eredin; break;
        case 'EBG_Combat_Olgierd': e_preferedCombatStyle = EBG_Combat_Olgierd; break;
        case 'EBG_Combat_Caretaker': e_preferedCombatStyle = EBG_Combat_Caretaker; break;
        case 'EBG_Combat_Dettlaff_Vampire': e_preferedCombatStyle = EBG_Combat_Dettlaff_Vampire; break;
        case 'EBG_Combat_Gregoire': e_preferedCombatStyle = EBG_Combat_Gregoire; break;
        case 'EBG_Combat_Dettlaff_Minion': e_preferedCombatStyle = EBG_Combat_Dettlaff_Minion; break;
    }
    ChangeCombatStyleByTag(e_preferedCombatStyle, npcTag);
}

quest function CjG_ChangeNPCStateQuest(npcTag : name, npcState : name, ignoreImmortalityMode : bool) {
    var e_npcState : EQuestNPCStates;
    switch (npcState) {
        case 'EQNS_Default': e_npcState = EQNS_Default; break;
        case 'EQNS_Dead': e_npcState = EQNS_Dead; break;
        case 'EQNS_Agony': e_npcState = EQNS_Agony; break;
        case 'EQNS_KnockedUnconscious': e_npcState = EQNS_KnockedUnconscious; break;
        case 'EQNS_DeadNoAgony': e_npcState = EQNS_DeadNoAgony; break;
        case 'EQNS_DeadInstantRagdoll': e_npcState = EQNS_DeadInstantRagdoll; break;
        case 'EQNS_Combat': e_npcState = EQNS_Combat; break;
    }
    ChangeNPCStateQuest(npcTag, e_npcState, ignoreImmortalityMode);
}

quest function CjG_CombatStageChange(npcsTag : name, stage : name) {
    var e_stage : ENPCFightStage;
    switch (stage) {
        case 'NFS_Stage1': e_stage = NFS_Stage1; break;
        case 'NFS_Stage2': e_stage = NFS_Stage2; break;
        case 'NFS_Stage3': e_stage = NFS_Stage3; break;
        case 'NFS_Stage4': e_stage = NFS_Stage4; break;
        case 'NFS_Stage5': e_stage = NFS_Stage5; break;
    }
    CombatStageChange(npcsTag, e_stage);
}

quest function CjG_DoorChangeState(tag : name, newState : name, optional keyItemName : name, optional removeKeyOnUse : bool, optional smoooth : bool, optional dontBlockInCombat : bool) {
    var e_newState : EDoorQuestState;
    switch (newState) {
        case 'EDQS_Open': e_newState = EDQS_Open; break;
        case 'EDQS_Close': e_newState = EDQS_Close; break;
        case 'EDQS_RemoveLock': e_newState = EDQS_RemoveLock; break;
        case 'EDQS_Enable': e_newState = EDQS_Enable; break;
        case 'EDQS_Disable': e_newState = EDQS_Disable; break;
        case 'EDQS_Lock': e_newState = EDQS_Lock; break;
    }
    DoorChangeState(tag, e_newState, keyItemName, removeKeyOnUse, smoooth, dontBlockInCombat);
}

quest function CjG_DrawWeaponQuest(weapon : name, dontIgnoreDrawActionLock : bool) {
    var e_weapon : EDrawWeaponQuestType;
    switch (weapon) {
        case 'EDWQT_Steel': e_weapon = EDWQT_Steel; break;
        case 'EDWQT_Silver': e_weapon = EDWQT_Silver; break;
        case 'EDWQT_NoWeapon': e_weapon = EDWQT_NoWeapon; break;
        case 'EDWQT_Fists': e_weapon = EDWQT_Fists; break;
    }
    DrawWeaponQuest(e_weapon, dontIgnoreDrawActionLock);
}

quest function CjG_DrawWeaponWithCombatQuest(weapon : name, dontIgnoreDrawActionLock : bool) {
    var e_weapon : EDrawWeaponQuestType;
    switch (weapon) {
        case 'EDWQT_Steel': e_weapon = EDWQT_Steel; break;
        case 'EDWQT_Silver': e_weapon = EDWQT_Silver; break;
        case 'EDWQT_NoWeapon': e_weapon = EDWQT_NoWeapon; break;
        case 'EDWQT_Fists': e_weapon = EDWQT_Fists; break;
    }
    DrawWeaponWithCombatQuest(e_weapon, dontIgnoreDrawActionLock);
}

quest function CjG_EnableDynamicMappin(tag : name, optional enable : bool, optional type : name, optional showAlways : bool) {
    var e_type : EDM_MappinType;
    switch (type) {
        case 'EDM_QuestAvailable': e_type = EDM_QuestAvailable; break;
        case 'EDM_MonsterNest': e_type = EDM_MonsterNest; break;
        case 'EDM_Prostitute': e_type = EDM_Prostitute; break;
        case 'EDM_HorseRacingNPC': e_type = EDM_HorseRacingNPC; break;
