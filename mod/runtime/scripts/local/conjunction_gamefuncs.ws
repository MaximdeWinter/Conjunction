quest function CjG_AddAllGwentCards(optional faction : name, optional ignoreLy : bool) {
    var e_faction : EGwentCardFaction;
    switch (faction) {
        case 'EGCF_Neutral': e_faction = EGCF_Neutral; break;
        case 'EGCF_Kingdoms': e_faction = EGCF_Kingdoms; break;
        case 'EGCF_Nilfgaard': e_faction = EGCF_Nilfgaard; break;
        case 'EGCF_Monsters': e_faction = EGCF_Monsters; break;
        case 'EGCF_Scoiatael': e_faction = EGCF_Scoiatael; break;
        case 'EGCG_Skellige': e_faction = EGCG_Skellige; break;
    }
    AddAllGwentCards(e_faction, ignoreLy);
}

quest function CjG_AddQuestMappinToNoticeboard(noticeboardTag : name, entityTag : name, entityType : name) {
    var e_entityType : AQMTN_EntityType;
    switch (entityType) {
        case 'AQMTN_Actor': e_entityType = AQMTN_Actor; break;
        case 'AQMTN_NonActor': e_entityType = AQMTN_NonActor; break;
    }
    AddQuestMappinToNoticeboard(noticeboardTag, entityTag, e_entityType);
}

quest function CjG_AnimalNervousState(npcsTag : name, reactionType : name, percents : int) {
    var e_reactionType : EAnimalReaction;
    switch (reactionType) {
        case 'AR_Rearing': e_reactionType = AR_Rearing; break;
        case 'AR_Kick': e_reactionType = AR_Kick; break;
        case 'AR_Backing': e_reactionType = AR_Backing; break;
        case 'AR_AddPanicPercents': e_reactionType = AR_AddPanicPercents; break;
    }
    AnimalNervousState(npcsTag, e_reactionType, percents);
}

quest function CjG_AssignNPCTemporaryGroupAttitudeQuest(npcTag : name, attGroup : name, priority : name, value : bool) {
    var e_priority : EAttitudeGroupPriority;
    switch (priority) {
        case 'AGP_Default': e_priority = AGP_Default; break;
        case 'AGP_SpawnTree': e_priority = AGP_SpawnTree; break;
        case 'AGP_Axii': e_priority = AGP_Axii; break;
        case 'AGP_Fistfight': e_priority = AGP_Fistfight; break;
        case 'AGP_Scenes': e_priority = AGP_Scenes; break;
    }
    AssignNPCTemporaryGroupAttitudeQuest(npcTag, attGroup, e_priority, value);
}

quest function CjG_ChangeCombatStyleByTag(preferedCombatStyle : name, npcTag : name) {
    var e_preferedCombatStyle : EBehaviorGraph;
    switch (preferedCombatStyle) {
        case 'EBG_None': e_preferedCombatStyle = EBG_None; break;
        case 'EBG_Combat_Undefined': e_preferedCombatStyle = EBG_Combat_Undefined; break;
        case 'EBG_Combat_Shield': e_preferedCombatStyle = EBG_Combat_Shield; break;
        case 'EBG_Combat_1Handed_Sword': e_preferedCombatStyle = EBG_Combat_1Handed_Sword; break;
